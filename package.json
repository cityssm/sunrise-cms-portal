{
  "name": "sunrise-cms-portal",
  "version": "1.0.0-dev",
  "private": true,
  "description": "A portal for funeral homes and the general public to interface with the Sunrise CMS (Cemetery Management System)",
  "keywords": [
    "sunrise-cms",
    "cemetery-management"
  ],
  "homepage": "https://github.com/cityssm/sunrise-cms-portal#readme",
  "bugs": {
    "url": "https://github.com/cityssm/sunrise-cms-portal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/sunrise-cms-portal.git"
  },
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --env-file=.dev.env ./index.js",
    "lint:cspell": "cspell lint \"**/*.{ts,ejs,css,html,md}\"",
    "lint:editorconfig": "editorconfig-checker",
    "lint:eslint:css": "eslint **/*.css",
    "lint:eslint:ejs": "eslint views/*.ejs views/**/*.ejs",
    "lint:eslint:html": "eslint public/html/*.html",
    "lint:eslint:md": "eslint **/*.md",
    "lint:eslint:ts": "eslint --ignore-pattern \"**/*.d.ts\" --ignore-pattern \"test/**\" --no-warn-ignored \"**/*.ts\"",
    "lint:markdown": "markdownlint-cli2 --config .markdownlint.json \"**/*.md\" \"#node_modules\" \"#.github\"",
    "start": "node --env-file=.env ./index.js"
  },
  "dependencies": {
    "@cityssm/bulma-js": "^1.0.0-rc.4",
    "@cityssm/cemetery-utils": "^0.3.0",
    "@cityssm/configurator": "^0.2.0",
    "@cityssm/express-abuse-points": "^4.0.0",
    "@cityssm/utils-datetime": "^1.4.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bulma": "^1.0.4",
    "chokidar": "^5.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "http-errors": "^2.0.1",
    "sunrise-cms-shared": "^0.0.11"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/node-windows": "^0.1.6",
    "cspell-cli": "^10.3.0",
    "editorconfig-checker": "^7.0.0",
    "eslint-config-cityssm": "^57.2.0",
    "markdownlint-cli2": "^0.23.3",
    "nodemon": "^3.1.14",
    "prettier-config-cityssm": "^2.2.0"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "engines": {
    "node": ">=22"
  }
}
